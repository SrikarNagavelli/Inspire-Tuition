# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (Maps JavaScript API)
# Restrict HTTP referrers in Google Cloud Console before production launch.
VITE_GOOGLE_MAPS_API_KEY=""

# Google Apps Script Web App URL for storing Demo Class enquiries in Google Sheets
# Keep this server-side only (do NOT prefix with VITE_)
GOOGLE_APPS_SCRIPT_URL=""

# Optional shared secret checked by google-apps-script/Code.gs before appending rows
GOOGLE_APPS_SCRIPT_SECRET=""

# Production origin used for page canonicals and the sitemap. Vercel supplies a default project domain.
SITE_CANONICAL_URL=""
